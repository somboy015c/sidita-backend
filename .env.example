# MongoDB Atlas connection string (see README for how to get this)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/sidita?retryWrites=true&w=majority

# Secret used to sign admin login tokens - make this a long random string
JWT_SECRET=replace-this-with-a-long-random-string

# Comma-separated list of frontend URLs allowed to call this API
# Example: https://yourusername.github.io,https://yourusername.github.io/sidita-admin,https://yourusername.github.io/sidita-customer
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Default admin account created the first time you run "npm run seed"
ADMIN_EMAIL=admin@sidita-rentals.com
ADMIN_PASSWORD=ChangeThisPassword123

PORT=4000
